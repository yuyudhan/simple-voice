# FilePath: .editorconfig
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
tab_width = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Tabs are syntactically required.
[{Makefile,makefile,GNUmakefile,*.mk}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# Matches taplo.toml.
[*.toml]
max_line_length = 100

# Machine-generated; tools rewrite these on their own terms.
[{Cargo.lock,bun.lock}]
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

# Matches rustfmt.toml.
[*.rs]
max_line_length = 100

# Matches .prettierrc.
[*.{ts,tsx,js,css}]
max_line_length = 100

# Matches engine/.swift-format.
[*.swift]
max_line_length = 120
