{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Simple Voice",
    "version": "0.0.7",
    "identifier": "dev.yuyudhan.simplevoice.mobile",
    "build": {
        "beforeDevCommand": "bun run --cwd .. vite --config mobile/vite.config.ts",
        "devUrl": "http://localhost:1430",
        "beforeBuildCommand": "bun run --cwd .. vite build --config mobile/vite.config.ts",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Simple Voice"
            }
        ],
        "security": {
            "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "category": "public.app-category.productivity",
        "shortDescription": "Dictation keyboard",
        "longDescription": "Speak in any app and polished text lands at the cursor.",
        "copyright": "© yuyudhan. MIT License.",
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
        "iOS": {
            "minimumSystemVersion": "17.0"
        }
    }
}
