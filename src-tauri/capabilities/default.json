{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Main window: app commands, events, window chrome, file dialogs, links",
    "windows": ["main"],
    "permissions": [
        "core:default",
        "core:event:default",
        "core:window:default",
        "core:window:allow-hide",
        "core:window:allow-show",
        "core:window:allow-set-focus",
        "core:window:allow-set-theme",
        "core:window:allow-start-dragging",
        "dialog:allow-open",
        "opener:default"
    ]
}
