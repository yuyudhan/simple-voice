{
    "$schema": "https://schema.tauri.app/config/2",
    "bundle": {
        "targets": ["deb"],
        "shortDescription": "System-wide dictation for Linux",
        "longDescription": "Speak anywhere on your Linux desktop and the text lands in the focused app. Transcription runs on this computer with Parakeet TDT (sherpa-onnx) or Whisper (whisper.cpp).",
        "linux": {
            "deb": {
                "section": "utils",
                "depends": [
                    "libayatana-appindicator3-1",
                    "xdotool",
                    "xclip",
                    "wl-clipboard",
                    "pulseaudio-utils",
                    "libsecret-tools"
                ]
            }
        }
    }
}
