{
    "name": "simple-voice",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "engine:build": "bash engine/build.sh debug",
        "engine:build:release": "bash engine/build.sh release",
        "lint": "eslint --max-warnings 0 .",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
        "format": "prettier --write src vite.config.ts eslint.config.js",
        "format:check": "prettier --check src vite.config.ts eslint.config.js"
    },
    "dependencies": {
        "@tauri-apps/api": "^2",
        "@tauri-apps/plugin-dialog": "^2.7.3",
        "@tauri-apps/plugin-global-shortcut": "^2.3.2",
        "@tauri-apps/plugin-opener": "^2",
        "lucide-react": "^1.48.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tauri-apps/cli": "^2",
        "@types/node": "^26.6.2",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.6",
        "@vitejs/plugin-react": "^6.0.2",
        "eslint": "^10.11.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.12.0",
        "prettier": "^3.9.9",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.0.16"
    },
    "license": "MIT"
}
